+    struct alignas(64) OverAlignedValue
+    {
+        std::uint8_t bytes[64];
+    };
+
+    TEST_CASE("MemoryManager: Honors requested type alignment", "[memory]")
+    {
+        MemoryManager memory;
+
+        auto* values = memory.Alloc<OverAlignedValue>(2);
+
+        REQUIRE(values != nullptr);
+        REQUIRE(reinterpret_cast<std::uintptr_t>(values) % alignof(OverAlignedValue) == 0);
+        REQUIRE(values[0].bytes[0] == 0);
+        REQUIRE(values[1].bytes[63] == 0);
+    }
+
+    TEST_CASE("MemoryManager: Rejects allocation-size overflow", "[memory][malformed]")
+    {
+        MemoryManager memory;
+
+        REQUIRE_THROWS_AS(memory.Alloc<std::uint64_t>(std::numeric_limits<std::size_t>::max()), std::bad_array_new_length);
+    }
+
+    TEST_CASE("MemoryManager: Rejects null string duplication", "[memory][malformed]")
+    {
+        MemoryManager memory;
+
+        REQUIRE_THROWS_AS(memory.Dup(nullptr), std::invalid_argument);
+    }
+
+    TEST_CASE("MemoryManager: Reports only complete managed ranges", "[memory][malformed]")
+    {
+        MemoryManager memory;
+        auto* data = memory.Alloc<std::uint8_t>(8u);
+
+        REQUIRE(memory.GetRemainingSize(data) == 8u);
+        REQUIRE(memory.GetRemainingSize(data + 3u) == 5u);
+        REQUIRE(memory.ContainsRange(data + 3u, 5u));
+        REQUIRE_FALSE(memory.ContainsRange(data + 3u, 6u));
+        REQUIRE_FALSE(memory.ContainsRange(data + 8u, 0u));
+    }
+
+    TEST_CASE("MemoryManager: Validates strings within their allocation", "[memory][malformed]")
+    {
+        MemoryManager memory;
+        auto* terminated = memory.Dup("valid");
+        auto* unterminated = memory.Alloc<char>(4u);
+        std::memcpy(unterminated, "test", 4u);
+
+        REQUIRE(memory.ContainsNullTerminatedString(terminated));
+        REQUIRE(memory.ContainsNullTerminatedString(terminated + 2u));
+        REQUIRE_FALSE(memory.ContainsNullTerminatedString(unterminated));
+        REQUIRE_FALSE(memory.ContainsNullTerminatedString(nullptr));
+    }
+
+    TEST_CASE("MemoryManager: Move assignment transfers ownership", "[memory]")
+    {
+        MemoryManager source;
+        auto* sourceData = source.Alloc<std::uint32_t>();
+        *sourceData = 0x12345678u;
+
+        MemoryManager destination;
+        auto* replacedData = destination.Alloc<std::uint32_t>();
+
+        destination = std::move(source);
+
+        REQUIRE(destination.Contains(sourceData));
+        REQUIRE(*sourceData == 0x12345678u);
+        REQUIRE_FALSE(destination.Contains(replacedData));
+        REQUIRE_FALSE(source.Contains(sourceData));
+    }
+} // namespace
diff --git a/test/ObjCommonTests/Shader/D3D11ShaderAnalyserTest.cpp b/test/ObjCommonTests/Shader/D3D11ShaderAnalyserTest.cpp
new file mode 100644
index 0000000..b434301
--- /dev/null
+++ b/test/ObjCommonTests/Shader/D3D11ShaderAnalyserTest.cpp
@@ -0,0 +1,126 @@
+#include "Shader/D3D11ShaderAnalyser.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t TAG_RDEF =
+        static_cast<uint32_t>('R') | (static_cast<uint32_t>('D') << 8u) | (static_cast<uint32_t>('E') << 16u) | (static_cast<uint32_t>('F') << 24u);
+    constexpr uint32_t TAG_SHDR =
+        static_cast<uint32_t>('S') | (static_cast<uint32_t>('H') << 8u) | (static_cast<uint32_t>('D') << 16u) | (static_cast<uint32_t>('R') << 24u);
+
+    void WriteU32(std::vector<std::byte>& data, const size_t offset, const uint32_t value)
+    {
+        REQUIRE(offset <= data.size());
+        REQUIRE(sizeof(value) <= data.size() - offset);
+        std::memcpy(data.data() + offset, &value, sizeof(value));
+    }
+
+    void AppendU32(std::vector<std::byte>& data, const uint32_t value)
+    {
+        const auto offset = data.size();
+        data.resize(offset + sizeof(value));
+        WriteU32(data, offset, value);
+    }
+
+    std::vector<std::byte> MakeMinimalShader()
+    {
+        constexpr size_t headerSize = 40u;
+        std::vector<std::byte> result(headerSize);
+        std::memcpy(result.data(), "DXBC", 4u);
+        WriteU32(result, 28u, 2u);
+
+        const auto rdefOffset = static_cast<uint32_t>(result.size());
+        WriteU32(result, 32u, rdefOffset);
+        AppendU32(result, TAG_RDEF);
+        AppendU32(result, 33u);
+        const auto rdefDataOffset = result.size();
+        result.resize(result.size() + 28u);
+        result[rdefDataOffset + 17u] = std::byte{5u};
+        WriteU32(result, rdefDataOffset + 24u, 28u);
+        const std::string creator = "test";
+        result.insert(
+            result.end(), reinterpret_cast<const std::byte*>(creator.c_str()), reinterpret_cast<const std::byte*>(creator.c_str() + creator.size() + 1u));
+
+        const auto shdrOffset = static_cast<uint32_t>(result.size());
+        WriteU32(result, 36u, shdrOffset);
+        AppendU32(result, TAG_SHDR);
+        AppendU32(result, sizeof(uint32_t));
+        AppendU32(result, (1u << 16u) | (5u << 4u));
+        WriteU32(result, 24u, static_cast<uint32_t>(result.size()));
+        return result;
+    }
+} // namespace
+
+TEST_CASE("D3D11ShaderAnalyser accepts a bounded minimal shader", "[shader][d3d11]")
+{
+    const auto shader = MakeMinimalShader();
+    const auto info = d3d11::ShaderAnalyser::GetShaderInfo(shader.data(), shader.size());
+
+    REQUIRE(info);
+    REQUIRE(info->m_creator == "test");
+    REQUIRE(info->m_type == d3d11::ShaderType::VERTEX_SHADER);
+    REQUIRE(info->m_version_major == 5u);
+    REQUIRE(info->m_version_minor == 0u);
+    REQUIRE(info->m_bound_resources.empty());
+    REQUIRE(info->m_constant_buffers.empty());
+}
+
+TEST_CASE("D3D11ShaderAnalyser rejects overflowing offsets and counts", "[shader][d3d11]")
+{
+    SECTION("Chunk count overflows the table")
+    {
+        auto shader = MakeMinimalShader();
+        WriteU32(shader, 28u, 0xffffffffu);
+        REQUIRE_FALSE(d3d11::ShaderAnalyser::GetShaderInfo(shader.data(), shader.size()));
+    }
+
+    SECTION("Chunk payload offset overflows the input")
+    {
+        auto shader = MakeMinimalShader();
+        WriteU32(shader, 32u, 0xffffffffu);
+        REQUIRE_FALSE(d3d11::ShaderAnalyser::GetShaderInfo(shader.data(), shader.size()));
+    }
+
+    SECTION("Creator offset escapes its chunk")
+    {
+        auto shader = MakeMinimalShader();
+        constexpr size_t rdefDataOffset = 40u + 2u * sizeof(uint32_t);
+        WriteU32(shader, rdefDataOffset + 24u, 0xffffffffu);
+        REQUIRE_FALSE(d3d11::ShaderAnalyser::GetShaderInfo(shader.data(), shader.size()));
+    }
+}
+
+TEST_CASE("D3D11ShaderAnalyser safely handles truncated and malformed bytecode", "[shader][d3d11]")
+{
+    SECTION("Every truncated prefix at an unaligned address")
+    {
+        const auto shader = MakeMinimalShader();
+        std::vector<std::byte> unalignedShader(shader.size() + 1u);
+        std::memcpy(unalignedShader.data() + 1u, shader.data(), shader.size());
+
+        for (size_t size = 0; size <= shader.size(); size++)
+            REQUIRE_NOTHROW(d3d11::ShaderAnalyser::GetShaderInfo(unalignedShader.data() + 1u, size));
+    }
+
+    SECTION("Deterministic malformed-input corpus")
+    {
+        uint32_t state = 0xD3D11u;
+        for (size_t size = 1; size <= 512u; size++)
+        {
+            std::vector<std::byte> data(size);
+            for (auto& value : data)
+            {
+                state = state * 1664525u + 1013904223u;
+                value = static_cast<std::byte>(state >> 24u);
+            }
+
+            REQUIRE_NOTHROW(d3d11::ShaderAnalyser::GetShaderInfo(data.data(), data.size()));
+        }
+    }
+}
