+            return false;
+
+        for (const auto& member : structure->m_ordered_members)
+        {
+            const auto hasPointer = std::ranges::any_of(member->m_member->m_type_declaration->m_declaration_modifiers,
+                                                        [](const auto& modifier)
+                                                        {
+                                                            return modifier->GetType() == DeclarationModifierType::POINTER;
+                                                        });
+            if (hasPointer)
+                return true;
+
+            if (member->m_type != nullptr && member->m_type != structure && ContainsEmbeddedPointer(member->m_type, visited))
+                return true;
+        }
+
+        return false;
+    }
