+#include "weaponcompletedef_actions.h"
+
+#include <stdexcept>
+#include <string>
+
+using namespace IW5;
+
+Actions_WeaponCompleteDef::Actions_WeaponCompleteDef(Zone& zone)
+    : AssetLoadingActions(zone)
+{
+}
+
+void Actions_WeaponCompleteDef::NormalizeWeaponCompleteDef(WeaponCompleteDef* weapon) const
+{
+    if (weapon->weapDef)
+        NormalizeWeaponDef(weapon->weapDef);
+
+    if (weapon->soundOverrides)
+    {
+        for (auto index = 0u; index < weapon->numSoundOverrides; index++)
+        {
+            NormalizeSndAliasCustom(weapon->soundOverrides[index].overrideSound);
+            NormalizeSndAliasCustom(weapon->soundOverrides[index].altmodeSound);
+        }
+    }
+}
+
+void Actions_WeaponCompleteDef::NormalizeWeaponDef(WeaponDef* weaponDef) const
+{
+    SndAliasCustom* directAliases[]{
+        &weaponDef->pickupSound,
+        &weaponDef->pickupSoundPlayer,
+        &weaponDef->ammoPickupSound,
+        &weaponDef->ammoPickupSoundPlayer,
+        &weaponDef->projectileSound,
+        &weaponDef->pullbackSound,
+        &weaponDef->pullbackSoundPlayer,
+        &weaponDef->fireSound,
+        &weaponDef->fireSoundPlayer,
+        &weaponDef->fireSoundPlayerAkimbo,
+        &weaponDef->fireLoopSound,
+        &weaponDef->fireLoopSoundPlayer,
+        &weaponDef->fireStopSound,
+        &weaponDef->fireStopSoundPlayer,
+        &weaponDef->fireLastSound,
+        &weaponDef->fireLastSoundPlayer,
+        &weaponDef->emptyFireSound,
+        &weaponDef->emptyFireSoundPlayer,
+        &weaponDef->meleeSwipeSound,
+        &weaponDef->meleeSwipeSoundPlayer,
+        &weaponDef->meleeHitSound,
+        &weaponDef->meleeMissSound,
+        &weaponDef->rechamberSound,
+        &weaponDef->rechamberSoundPlayer,
+        &weaponDef->reloadSound,
+        &weaponDef->reloadSoundPlayer,
+        &weaponDef->reloadEmptySound,
+        &weaponDef->reloadEmptySoundPlayer,
+        &weaponDef->reloadStartSound,
+        &weaponDef->reloadStartSoundPlayer,
+        &weaponDef->reloadEndSound,
+        &weaponDef->reloadEndSoundPlayer,
+        &weaponDef->detonateSound,
+        &weaponDef->detonateSoundPlayer,
+        &weaponDef->nightVisionWearSound,
+        &weaponDef->nightVisionWearSoundPlayer,
+        &weaponDef->nightVisionRemoveSound,
+        &weaponDef->nightVisionRemoveSoundPlayer,
+        &weaponDef->altSwitchSound,
+        &weaponDef->altSwitchSoundPlayer,
+        &weaponDef->raiseSound,
+        &weaponDef->raiseSoundPlayer,
+        &weaponDef->firstRaiseSound,
+        &weaponDef->firstRaiseSoundPlayer,
+        &weaponDef->putawaySound,
+        &weaponDef->putawaySoundPlayer,
+        &weaponDef->scanSound,
+        &weaponDef->changeVariableZoomSound,
+        &weaponDef->projExplosionSound,
+        &weaponDef->projDudSound,
+        &weaponDef->projIgnitionSound,
+        &weaponDef->turretOverheatSound,
+        &weaponDef->turretBarrelSpinMaxSnd,
+        &weaponDef->missileConeSoundAlias,
+        &weaponDef->missileConeSoundAliasAtBase,
+    };
+
+    for (auto* alias : directAliases)
+        NormalizeSndAliasCustom(*alias);
+
+    if (weaponDef->bounceSound)
+    {
+        for (auto index = 0u; index < SURF_TYPE_COUNT; index++)
+            NormalizeSndAliasCustom(weaponDef->bounceSound[index]);
+    }
+
+    if (weaponDef->rollingSound)
+    {
+        for (auto index = 0u; index < SURF_TYPE_COUNT; index++)
+            NormalizeSndAliasCustom(weaponDef->rollingSound[index]);
+    }
+
+    for (auto& alias : weaponDef->turretBarrelSpinUpSnd)
+        NormalizeSndAliasCustom(alias);
+    for (auto& alias : weaponDef->turretBarrelSpinDownSnd)
+        NormalizeSndAliasCustom(alias);
+}
+
+void Actions_WeaponCompleteDef::NormalizeSndAliasCustom(SndAliasCustom& alias) const
+{
+    if (!alias.name)
+        return;
+
+    auto& memory = m_zone.Memory();
+    if (memory.ContainsRange(alias.name, sizeof(*alias.name)))
+    {
+        const auto* soundName = alias.name->soundName;
+        if (!soundName || memory.ContainsNullTerminatedString(soundName))
+            return;
+    }
+
+    // IW5 occasionally aliases this single-pointer wrapper directly to its string payload.
+    // This is layout-equivalent on the original 32-bit target, but needs a native wrapper here.
+    const auto* directSoundName = reinterpret_cast<const char*>(alias.name);
+    if (!memory.ContainsNullTerminatedString(directSoundName))
+        throw std::runtime_error("Sound alias name points outside managed zone memory");
+
+    alias.name = memory.Alloc<snd_alias_list_name>();
+    alias.name->soundName = directSoundName;
+}
