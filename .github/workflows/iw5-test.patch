@@ -2,6 +2,7 @@
 
 #include "Parsing/Commands/Matcher/CommandsCommonMatchers.h"
 #include "Parsing/Commands/Matcher/CommandsMatcherFactory.h"
+#include "SequenceNullTerminatedPointerArrayElements.h"
 
 namespace
 {
@@ -36,3 +37,32 @@ void SequenceReusablePointerArrayElements::ProcessMatch(CommandsParserState* sta
 
     members.back()->m_pointer_array_elements_are_reusable = true;
 }
+
+SequenceNullTerminatedPointerArrayElements::SequenceNullTerminatedPointerArrayElements()
+{
+    const CommandsMatcherFactory create(this);
+
+    AddLabeledMatchers(CommandsCommonMatchers::Typename(this), CommandsCommonMatchers::LABEL_TYPENAME);
+    AddMatchers({
+        create.Keyword("set"),
+        create.Keyword("nullterminated"),
+        create.Keyword("elements"),
+        create.Label(CommandsCommonMatchers::LABEL_TYPENAME).Capture(CAPTURE_TYPE),
+        create.Char(';'),
+    });
+}
+
+void SequenceNullTerminatedPointerArrayElements::ProcessMatch(CommandsParserState* state, SequenceResult<CommandsParserValue>& result) const
+{
+    const auto& typeNameToken = result.NextCapture(CAPTURE_TYPE);
+
+    StructureInformation* type;
+    std::vector<MemberInformation*> members;
+    if (!state->GetTypenameAndMembersFromTypename(typeNameToken.TypeNameValue(), type, members))
+        throw ParsingException(typeNameToken.GetPos(), "Unknown type");
+
+    if (members.empty())
+        throw ParsingException(typeNameToken.GetPos(), "Need to specify a pointer-array member when marking its elements as null-terminated.");
+
+    members.back()->m_pointer_array_elements_are_null_terminated = true;
+}
