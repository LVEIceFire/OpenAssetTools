+#include <cstdint>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+
+namespace
+{
+    class ThrowStandardExceptionStep final : public ILoadingStep
+    {
+    public:
+        void PerformStep(ZoneLoader&, ILoadingStream&) override
+        {
+            throw std::runtime_error("malformed zone");
+        }
+    };
+
+    class ThrowUnknownExceptionStep final : public ILoadingStep
+    {
+    public:
+        void PerformStep(ZoneLoader&, ILoadingStream&) override
+        {
+            throw 1;
+        }
+    };
+
+    TEST_CASE("ZoneLoader: Rejects standard exceptions from loading steps", "[loading][malformed]")
+    {
+        ZoneLoader loader(std::make_unique<Zone>("test", 0, GameId::IW5, GamePlatform::PC));
+        loader.AddLoadingStep(std::make_unique<ThrowStandardExceptionStep>());
+        std::istringstream stream;
+
+        REQUIRE(loader.LoadZone(stream) == nullptr);
+    }
+
+    TEST_CASE("ZoneLoader: Rejects unknown exceptions from loading steps", "[loading][malformed]")
+    {
+        ZoneLoader loader(std::make_unique<Zone>("test", 0, GameId::IW5, GamePlatform::PC));
+        loader.AddLoadingStep(std::make_unique<ThrowUnknownExceptionStep>());
+        std::istringstream stream;
+
+        REQUIRE(loader.LoadZone(stream) == nullptr);
+    }
+
+    TEST_CASE("ZoneLoader: Rejects a truncated skipped field", "[loading][malformed]")
+    {
+        ZoneLoader loader(std::make_unique<Zone>("test", 0, GameId::IW5, GamePlatform::PC));
+        loader.AddLoadingStep(step::CreateStepSkipBytes(2));
+        std::istringstream stream("x");
+
+        REQUIRE(loader.LoadZone(stream) == nullptr);
+    }
+
+    TEST_CASE("ZoneDataPeeking: Rejects a truncated structure", "[loading][malformed]")
+    {
+        std::istringstream stream("abc");
+        ZoneDataPeeking dataPeeking(stream);
+
+        REQUIRE_THROWS_AS(dataPeeking.PeekStruct<uint32_t>(), UnexpectedEndOfFileException);
+        REQUIRE_THROWS_AS(dataPeeking.PeekStruct<uint32_t>(), UnexpectedEndOfFileException);
+    }
+
+    TEST_CASE("ZoneDataPeeking: Copies a complete structure safely", "[loading]")
+    {
+        std::istringstream stream("abcd");
+        ZoneDataPeeking dataPeeking(stream);
+        const auto value = dataPeeking.PeekStruct<std::array<char, 4>>();
+
+        REQUIRE(value == std::array<char, 4>{'a', 'b', 'c', 'd'});
+    }
+
+    TEST_CASE("ZoneLoading: Gracefully rejects a truncated header", "[loading][malformed]")
+    {
+        constexpr std::array<uint8_t, 11> PARTIAL_IW5_HEADER{'I', 'W', 'f', 'f', 'u', '1', '0', '0', 1, 0, 0};
+        const auto path = oat::paths::GetTempDirectory("ZoneLoadingTruncatedHeader") / "truncated.ff";
+        {
+            std::ofstream stream(path, std::ios::binary);
+            REQUIRE(stream.is_open());
+            stream.write(reinterpret_cast<const char*>(PARTIAL_IW5_HEADER.data()), PARTIAL_IW5_HEADER.size());
+        }
+
+        const auto result = ZoneLoading::LoadZone(path.string(), std::nullopt);
+
+        REQUIRE_FALSE(result.has_value());
+    }
+} // namespace
