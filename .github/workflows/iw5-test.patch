diff --git a/src/ObjWriting/RawFile/RawFileZlib.h b/src/ObjWriting/RawFile/RawFileZlib.h
new file mode 100644
index 0000000..6521b69
--- /dev/null
+++ b/src/ObjWriting/RawFile/RawFileZlib.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <vector>
+#include <zlib.h>
+
+namespace raw_file::zlib
+{
+    constexpr size_t MAX_INFLATED_SIZE = 0xC000000u;
+
+    inline std::optional<std::vector<char>>
+        InflateExact(const void* input, const size_t inputSize, const size_t expectedOutputSize, const int windowBits = MAX_WBITS)
+    {
+        if (!input || inputSize == 0u || inputSize > std::numeric_limits<uInt>::max() || expectedOutputSize > MAX_INFLATED_SIZE)
+            return std::nullopt;
+
+        // The extra byte lets inflate consume the stream trailer even when the
+        // expected payload exactly fills its advertised output size. It also
+        // makes any excess decompressed byte observable and therefore invalid.
+        std::vector<char> output(expectedOutputSize + 1u);
+
+        z_stream stream{};
+        stream.next_in = reinterpret_cast<Bytef*>(const_cast<void*>(input));
+        stream.avail_in = static_cast<uInt>(inputSize);
+        stream.next_out = reinterpret_cast<Bytef*>(output.data());
+        stream.avail_out = static_cast<uInt>(output.size());
+
+        if (inflateInit2(&stream, windowBits) != Z_OK)
+            return std::nullopt;
+
+        const auto result = inflate(&stream, Z_FINISH);
+        const auto endResult = inflateEnd(&stream);
+        if (result != Z_STREAM_END || endResult != Z_OK || stream.avail_in != 0u || stream.total_out != expectedOutputSize)
+            return std::nullopt;
+
+        output.resize(expectedOutputSize);
+        return output;
+    }
+} // namespace raw_file::zlib
