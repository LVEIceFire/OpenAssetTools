+    bool HasNativeAlignmentConflict(const StructureInformation* structure, std::unordered_set<const StructureInformation*>& visited)
+    {
+        if (!visited.emplace(structure).second)
+            return false;
+
+        const auto pointerAlignment = GetPointerSizeForWordSize(OWN_WORD_SIZE);
+        const auto forcedNarrowAlignment = structure->m_definition->GetForceAlignment() && structure->m_definition->GetAlignment() < pointerAlignment;
+        if (forcedNarrowAlignment)
+        {
+            std::unordered_set<const StructureInformation*> pointerVisited;
+            if (ContainsEmbeddedPointer(structure, pointerVisited))
+                return true;
+        }
+
+        for (const auto& member : structure->m_ordered_members)
+        {
+            const auto hasPointer = std::ranges::any_of(member->m_member->m_type_declaration->m_declaration_modifiers,
+                                                        [](const auto& modifier)
+                                                        {
+                                                            return modifier->GetType() == DeclarationModifierType::POINTER;
+                                                        });
+            if (hasPointer)
+                continue;
+
+            if (member->m_type != nullptr && member->m_type != structure && HasNativeAlignmentConflict(member->m_type, visited))
