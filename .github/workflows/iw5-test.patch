@@ -0,0 +1,209 @@
+#include "Game/IW4/RawFile/RawFileDumperIW4.h"
+#include "Game/IW5/RawFile/RawFileDumperIW5.h"
+#include "Game/T5/RawFile/RawFileDumperT5.h"
+#include "Game/T6/RawFile/RawFileDumperT6.h"
+#include "RawFile/RawFileZlib.h"
+#include "SearchPath/MockOutputPath.h"
+#include "SearchPath/MockSearchPath.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+#include <zlib.h>
+
+namespace
+{
+    std::vector<char> Compress(const std::string& input, const bool raw)
+    {
+        z_stream stream{};
+        REQUIRE(deflateInit2(&stream, Z_DEFAULT_COMPRESSION, Z_DEFLATED, raw ? -MAX_WBITS : MAX_WBITS, 8, Z_DEFAULT_STRATEGY) == Z_OK);
+
+        std::vector<char> output(compressBound(static_cast<uLong>(input.size())) + 16u);
+        stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(input.data()));
+        stream.avail_in = static_cast<uInt>(input.size());
+        stream.next_out = reinterpret_cast<Bytef*>(output.data());
+        stream.avail_out = static_cast<uInt>(output.size());
+        REQUIRE(deflate(&stream, Z_FINISH) == Z_STREAM_END);
+        output.resize(stream.total_out);
+        REQUIRE(deflateEnd(&stream) == Z_OK);
+        return output;
+    }
+
+    void AppendU32(std::vector<char>& data, const uint32_t value)
+    {
+        const auto oldSize = data.size();
+        data.resize(oldSize + sizeof(value));
+        std::memcpy(data.data() + oldSize, &value, sizeof(value));
+    }
+
+    TEST_CASE("RawFile zlib helper accepts only one exact stream", "[rawfile][zlib]")
+    {
+        const std::string payload("hello\0binary", 12);
+        const auto wrapped = Compress(payload, false);
+        const auto raw = Compress(payload, true);
+
+        const auto inflatedWrapped = raw_file::zlib::InflateExact(wrapped.data(), wrapped.size(), payload.size());
+        const auto inflatedRaw = raw_file::zlib::InflateExact(raw.data(), raw.size(), payload.size(), -MAX_WBITS);
+        REQUIRE(inflatedWrapped);
+        REQUIRE(*inflatedWrapped == std::vector<char>(payload.begin(), payload.end()));
+        REQUIRE(inflatedRaw);
+        REQUIRE(*inflatedRaw == std::vector<char>(payload.begin(), payload.end()));
+
+        auto malformed = wrapped;
+        malformed.pop_back();
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(malformed.data(), malformed.size(), payload.size()));
+
+        malformed = wrapped;
+        malformed.push_back('\0');
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(malformed.data(), malformed.size(), payload.size()));
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(wrapped.data(), wrapped.size(), payload.size() - 1u));
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(wrapped.data(), wrapped.size(), payload.size() + 1u));
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(nullptr, wrapped.size(), payload.size()));
+        REQUIRE_FALSE(raw_file::zlib::InflateExact(wrapped.data(), wrapped.size(), raw_file::zlib::MAX_INFLATED_SIZE + 1u));
+    }
+
+    TEST_CASE("IW4 and IW5 rawfile dumpers reject malformed compressed data", "[rawfile][iw4][iw5]")
+    {
+        const std::string payload = "rawfile contents";
+        auto compressed = Compress(payload, false);
+
+        SECTION("IW4 exact stream")
+        {
+            Zone zone("MockZone", 0, GameId::IW4, GamePlatform::PC);
+            MockSearchPath searchPath;
+            MockOutputPath output;
+            AssetDumpingContext context(zone, "", output, searchPath, std::nullopt);
+            IW4::RawFile rawFile{"test.txt", static_cast<int>(compressed.size()), static_cast<int>(payload.size()), {compressed.data()}};
+            zone.m_pools.AddAsset(std::make_unique<XAssetInfo<IW4::RawFile>>(IW4::ASSET_TYPE_RAWFILE, rawFile.name, &rawFile));
+
+            raw_file::DumperIW4().Dump(context);
+            REQUIRE(output.GetMockedFile("test.txt")->AsString() == payload);
+        }
+
+        SECTION("IW5 trailing data")
+        {
+            compressed.push_back('\0');
+            Zone zone("MockZone", 0, GameId::IW5, GamePlatform::PC);
+            MockSearchPath searchPath;
+            MockOutputPath output;
+            AssetDumpingContext context(zone, "", output, searchPath, std::nullopt);
+            IW5::RawFile rawFile{"test.txt", static_cast<int>(compressed.size()), static_cast<int>(payload.size()), compressed.data()};
+            zone.m_pools.AddAsset(std::make_unique<XAssetInfo<IW5::RawFile>>(IW5::ASSET_TYPE_RAWFILE, rawFile.name, &rawFile));
+
+            raw_file::DumperIW5().Dump(context);
+            REQUIRE(output.GetMockedFile("test.txt") == nullptr);
+        }
+    }
+
+    TEST_CASE("T5 script dumper verifies lengths and trailing null", "[rawfile][t5]")
+    {
+        const std::string payload = "main() {}";
+        const std::string terminatedPayload(payload + '\0');
+        const auto compressed = Compress(terminatedPayload, false);
+        std::vector<char> stored;
+        AppendU32(stored, static_cast<uint32_t>(terminatedPayload.size()));
+        AppendU32(stored, static_cast<uint32_t>(compressed.size()));
+        stored.insert(stored.end(), compressed.begin(), compressed.end());
+
+        Zone zone("MockZone", 0, GameId::T5, GamePlatform::PC);
+        MockSearchPath searchPath;
+        MockOutputPath output;
+        AssetDumpingContext context(zone, "", output, searchPath, std::nullopt);
+        T5::RawFile rawFile{"test.gsc", static_cast<int>(stored.size()), stored.data()};
+        zone.m_pools.AddAsset(std::make_unique<XAssetInfo<T5::RawFile>>(T5::ASSET_TYPE_RAWFILE, rawFile.name, &rawFile));
+
+        raw_file::DumperT5().Dump(context);
+        REQUIRE(output.GetMockedFile("test.gsc")->AsString() == payload);
+
+        SECTION("declared compressed length must match")
+        {
+            stored[4]++;
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT5().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.gsc") == nullptr);
+        }
+
+        SECTION("payload must end in the advertised null byte")
+        {
+            const auto withoutNull = Compress(payload, false);
+            stored.clear();
+            AppendU32(stored, static_cast<uint32_t>(payload.size()));
+            AppendU32(stored, static_cast<uint32_t>(withoutNull.size()));
+            stored.insert(stored.end(), withoutNull.begin(), withoutNull.end());
+            rawFile.len = static_cast<int>(stored.size());
+            rawFile.buffer = stored.data();
+
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT5().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.gsc") == nullptr);
+        }
+
+        SECTION("trailing compressed bytes are rejected")
+        {
+            stored.push_back('\0');
+            const auto inputLength = static_cast<uint32_t>(compressed.size() + 1u);
+            std::memcpy(stored.data() + sizeof(uint32_t), &inputLength, sizeof(inputLength));
+            rawFile.len = static_cast<int>(stored.size());
+            rawFile.buffer = stored.data();
+
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT5().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.gsc") == nullptr);
+        }
+    }
+
+    TEST_CASE("T6 animtree dumper requires an exact raw-deflate stream", "[rawfile][t6]")
+    {
+        const std::string payload = "animtree contents";
+        auto compressed = Compress(payload, true);
+        std::vector<char> stored;
+        AppendU32(stored, static_cast<uint32_t>(payload.size()));
+        stored.insert(stored.end(), compressed.begin(), compressed.end());
+
+        Zone zone("MockZone", 0, GameId::T6, GamePlatform::PC);
+        MockSearchPath searchPath;
+        MockOutputPath output;
+        AssetDumpingContext context(zone, "", output, searchPath, std::nullopt);
+        T6::RawFile rawFile{"test.atr", static_cast<int>(stored.size()), reinterpret_cast<T6::char16*>(stored.data())};
+        zone.m_pools.AddAsset(std::make_unique<XAssetInfo<T6::RawFile>>(T6::ASSET_TYPE_RAWFILE, rawFile.name, &rawFile));
+
+        raw_file::DumperT6().Dump(context);
+        REQUIRE(output.GetMockedFile("test.atr")->AsString() == payload);
+
+        SECTION("trailing bytes are rejected")
+        {
+            stored.push_back('\0');
+            rawFile.len = static_cast<int>(stored.size());
+            rawFile.buffer = reinterpret_cast<T6::char16*>(stored.data());
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT6().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.atr") == nullptr);
+        }
+
+        SECTION("truncated streams are rejected")
+        {
+            stored.pop_back();
+            rawFile.len = static_cast<int>(stored.size());
+            rawFile.buffer = reinterpret_cast<T6::char16*>(stored.data());
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT6().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.atr") == nullptr);
+        }
+
+        SECTION("incorrect output sizes are rejected")
+        {
+            stored[0]--;
+            MockOutputPath malformedOutput;
+            AssetDumpingContext malformedContext(zone, "", malformedOutput, searchPath, std::nullopt);
+            raw_file::DumperT6().Dump(malformedContext);
+            REQUIRE(malformedOutput.GetMockedFile("test.atr") == nullptr);
+        }
+    }
+} // namespace
