+#include "Utils/Arguments/CommandLineOption.h"
+#include "Utils/Arguments/UsageInformation.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    TEST_CASE("Usage information wraps descriptions without splitting words", "[arguments][usage]")
+    {
+        const std::unique_ptr<CommandLineOption> helpOption(CommandLineOption::Builder::Create()
+                                                                 .WithShortName("?")
+                                                                 .WithLongName("help")
+                                                                 .WithDescription("Displays usage information.")
+                                                                 .Build());
+        const std::unique_ptr<CommandLineOption> outputOption(CommandLineOption::Builder::Create()
+                                                                   .WithLongName("output-folder")
+                                                                   .WithParameter("outputFolderPath")
+                                                                   .WithDescription(
+                                                                       "Specifies the output folder containing the contents of the unlinked zones. "
+                                                                       "Keeps placeholder_token_that_must_stay_intact as one word.")
+                                                                   .Build());
+        const CommandLineOption* options[]{helpOption.get(), outputOption.get()};
+
+        UsageInformation usage("Tool.exe");
+        for (const auto* option : options)
+            usage.AddCommandLineOption(option);
+        usage.AddArgument("path");
+
+        constexpr size_t lineWidth = 100u;
+        const auto text = usage.BuildText(lineWidth);
+        std::istringstream lines(text);
+        std::string line;
+        while (std::getline(lines, line))
+            REQUIRE(line.size() <= lineWidth);
+
+        REQUIRE(text.find("placeholder_token_that_must_stay_intact") != std::string::npos);
+    }
+}
