+}
+
+void* MemoryManager::AllocRaw(const size_t size, const size_t alignment)
+{
+    if (alignment == 0 || (alignment & (alignment - 1u)) != 0)
+        throw std::invalid_argument("Memory alignment must be a power of two");
+    if (size > std::numeric_limits<size_t>::max() - (alignment - 1u))
+        throw std::bad_array_new_length();
+
+    const auto allocationSize = std::max(size, size_t{1}) + alignment - 1u;
+    auto* base = calloc(allocationSize, 1u);
+    if (!base)
+        throw std::bad_alloc();
+
+    const auto address = reinterpret_cast<std::uintptr_t>(base);
+    auto* result = reinterpret_cast<void*>((address + alignment - 1u) & ~(static_cast<std::uintptr_t>(alignment) - 1u));
+    try
+    {
+        m_allocations.push_back({result, base, std::max(size, size_t{1})});
+    }
+    catch (...)
+    {
+        free(base);
+        throw;
+    }
 
     return result;
 }
 
 char* MemoryManager::Dup(const char* str)
 {
+    if (!str)
+        throw std::invalid_argument("Cannot duplicate a null string");
+
 #ifdef _MSC_VER
     auto* result = _strdup(str);
 #else
     auto* result = strdup(str);
 #endif
-    m_allocations.push_back(result);
+    if (!result)
+        throw std::bad_alloc();
+    try
+    {
+        m_allocations.push_back({result, result, std::strlen(result) + 1u});
+    }
+    catch (...)
+    {
+        free(result);
+        throw;
+    }
 
     return result;
 }
 
+std::optional<size_t> MemoryManager::GetRemainingSize(const void* data) const
+{
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    for (const auto& allocation : m_allocations)
+    {
+        const auto begin = reinterpret_cast<std::uintptr_t>(allocation.m_data);
+        if (address >= begin && address - begin < allocation.m_size)
+            return allocation.m_size - (address - begin);
+    }
+
+    return std::nullopt;
+}
+
+bool MemoryManager::Contains(const void* data) const
+{
+    return GetRemainingSize(data).has_value();
+}
+
+bool MemoryManager::ContainsRange(const void* data, const size_t size) const
+{
+    const auto remainingSize = GetRemainingSize(data);
+    return remainingSize.has_value() && size <= *remainingSize;
+}
+
+bool MemoryManager::ContainsNullTerminatedString(const char* str) const
+{
+    if (str == nullptr)
+        return false;
+
+    const auto remainingSize = GetRemainingSize(str);
+    return remainingSize.has_value() && std::memchr(str, '\0', *remainingSize) != nullptr;
+}
+
