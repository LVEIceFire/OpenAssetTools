diff --git a/src/ZoneCodeGeneratorLib/Parsing/PostProcessing/SerializedLayoutPostProcessor.cpp b/src/ZoneCodeGeneratorLib/Parsing/PostProcessing/SerializedLayoutPostProcessor.cpp
new file mode 100644
index 0000000..39c8d47
--- /dev/null
+++ b/src/ZoneCodeGeneratorLib/Parsing/PostProcessing/SerializedLayoutPostProcessor.cpp
@@ -0,0 +1,261 @@
+#include "SerializedLayoutPostProcessor.h"
+
+#include "Domain/Definition/ArrayDeclarationModifier.h"
+#include "Utils/Alignment.h"
+#include "Utils/Logging/Log.h"
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <ranges>
+#include <set>
+#include <vector>
+
+namespace
+{
+    struct Layout
+    {
+        unsigned m_size;
+        unsigned m_alignment;
+    };
+
+    class LayoutCalculator
+    {
+    public:
+        explicit LayoutCalculator(IDataRepository* repository)
+            : m_repository(repository),
+              m_default_word_size(repository->GetWordSize())
+        {
+        }
+
+        bool Calculate()
+        {
+            for (auto* info : m_repository->GetAllStructureInformation())
+            {
+                if (!Definition(info->m_definition, std::nullopt).has_value())
+                    return false;
+            }
+
+            return true;
+        }
+
+    private:
+        std::optional<Layout> Definition(const DefinitionWithMembers* definition, const std::optional<WordSize> ownerWordSize)
+        {
+            auto* info = m_repository->GetInformationFor(definition);
+            const auto wordSize = info && info->m_word_size != WordSize::UNKNOWN ? info->m_word_size : ownerWordSize.value_or(m_default_word_size);
+            const auto key = std::make_pair(definition, wordSize);
+            const auto existing = m_layouts.find(key);
+            if (existing != m_layouts.end())
+                return existing->second;
+            if (!m_calculating.emplace(key).second)
+            {
+                con::error("Detected circular embedded structure while calculating serialized layout for '{}'.", definition->GetFullName());
+                return std::nullopt;
+            }
+
+            unsigned definitionAlignment = definition->GetForceAlignment() ? definition->GetAlignment() : 0u;
+            std::vector<Layout> memberLayouts;
+            memberLayouts.reserve(definition->m_members.size());
+            for (const auto& member : definition->m_members)
+            {
+                const auto memberLayout = Declaration(*member->m_type_declaration, wordSize);
+                if (!memberLayout.has_value())
+                {
+                    m_calculating.erase(key);
+                    return std::nullopt;
+                }
+                memberLayouts.emplace_back(*memberLayout);
+
+                if (!definition->GetForceAlignment())
+                {
+                    const auto alignment = member->GetForceAlignment() ? member->GetAlignment() : std::min(memberLayout->m_alignment, definition->m_pack);
+                    definitionAlignment = std::max(definitionAlignment, alignment);
+                }
+            }
+
+            unsigned definitionSize = 0u;
+            unsigned currentBitOffset = 0u;
+            const auto isUnion = definition->GetType() == DataDefinitionType::UNION;
+            std::vector<std::pair<unsigned, unsigned>> serializedMembers;
+            serializedMembers.reserve(definition->m_members.size());
+            for (size_t index = 0; index < definition->m_members.size(); ++index)
+            {
+                const auto& member = definition->m_members[index];
+                const auto& memberLayout = memberLayouts[index];
+                unsigned memberOffset = 0u;
+
+                if (isUnion)
+                {
+                    definitionSize = std::max(definitionSize, memberLayout.m_size);
+                }
+                else if (member->m_type_declaration->m_has_custom_bit_size)
+                {
+                    memberOffset = definitionSize + currentBitOffset / 8u;
+                    currentBitOffset += member->m_type_declaration->m_custom_bit_size;
+                }
+                else
+                {
+                    if (currentBitOffset > 0u)
+                    {
+                        currentBitOffset = utils::Align(currentBitOffset, 8u);
+                        definitionSize += currentBitOffset / 8u;
+                        currentBitOffset = 0u;
+                    }
+
+                    const auto alignment = member->GetForceAlignment() ? member->GetAlignment() : std::min(memberLayout.m_alignment, definition->m_pack);
+                    definitionSize = utils::Align(definitionSize, alignment);
+                    memberOffset = definitionSize;
+                    definitionSize += memberLayout.m_size;
+                }
+
+                unsigned serializedTypeSize;
+                const auto containsPointer = std::ranges::any_of(member->m_type_declaration->m_declaration_modifiers,
+                                                                 [](const auto& modifier)
+                                                                 {
+                                                                     return modifier->GetType() == DeclarationModifierType::POINTER;
+                                                                 });
+                if (containsPointer)
+                {
+                    // Fill offset calculations replace pointer modifiers with
+                    // their serialized width, so the pointee size is not used.
+                    // Keeping the native size also avoids recursing through
+                    // ordinary self-referential pointer members.
+                    serializedTypeSize = member->m_type_declaration->m_type->GetSize();
+                }
+                else
+                {
+                    const auto typeLayout = Type(member->m_type_declaration->m_type, wordSize);
+                    if (!typeLayout.has_value())
+                    {
+                        m_calculating.erase(key);
+                        return std::nullopt;
+                    }
+                    serializedTypeSize = typeLayout->m_size;
+                }
+                serializedMembers.emplace_back(memberOffset, serializedTypeSize);
+            }
+
+            if (!isUnion && currentBitOffset > 0u)
+            {
+                currentBitOffset = utils::Align(currentBitOffset, 8u);
+                definitionSize += currentBitOffset / 8u;
+            }
+            definitionAlignment = std::max(definitionAlignment, 1u);
+            definitionSize = utils::Align(definitionSize, definitionAlignment);
+
+            const Layout layout{definitionSize, definitionAlignment};
+            m_layouts.emplace(key, layout);
+            m_calculating.erase(key);
+
+            // Keep one alternate layout alongside the native definition. A
+            // 32-bit owner propagates its pointer width into embedded structs.
+            // A later native traversal must not overwrite that alternate data.
+            const auto shouldRecord = info && (wordSize != m_default_word_size || info->m_serialized_word_size == WordSize::UNKNOWN);
+            if (shouldRecord)
+            {
+                info->m_serialized_word_size = wordSize;
+                info->m_serialized_size = definitionSize;
+                info->m_serialized_alignment = definitionAlignment;
+                info->m_has_serialized_layout_difference = definitionSize != definition->GetSize();
+                for (size_t index = 0; index < definition->m_members.size(); ++index)
+                {
+                    const auto& member = definition->m_members[index];
+                    const auto memberInfoEntry = std::ranges::find_if(info->m_ordered_members,
+                                                                      [&member](const auto& candidate)
+                                                                      {
+                                                                          return candidate->m_member == member.get();
+                                                                      });
+                    if (memberInfoEntry == info->m_ordered_members.end())
+                    {
+                        con::error("Could not find member information for '{}::{}'.", definition->GetFullName(), member->m_name);
+                        return std::nullopt;
+                    }
+
+                    auto* memberInfo = memberInfoEntry->get();
+                    memberInfo->m_serialized_offset = serializedMembers[index].first;
+                    memberInfo->m_serialized_type_size = serializedMembers[index].second;
+                    if (memberInfo->m_serialized_offset != memberInfo->m_member->m_offset
+                        || memberInfo->m_serialized_type_size != memberInfo->m_member->m_type_declaration->m_type->GetSize())
+                        info->m_has_serialized_layout_difference = true;
+                }
+            }
+
+            return layout;
+        }
+
+        std::optional<Layout> Type(const DataDefinition* definition, const WordSize ownerWordSize)
+        {
+            switch (definition->GetType())
+            {
+            case DataDefinitionType::STRUCT:
+            case DataDefinitionType::UNION:
+                return Definition(dynamic_cast<const DefinitionWithMembers*>(definition), ownerWordSize);
+
+            case DataDefinitionType::TYPEDEF:
+            {
+                const auto* typedefDefinition = dynamic_cast<const TypedefDefinition*>(definition);
+                auto layout = Declaration(*typedefDefinition->m_type_declaration, ownerWordSize);
+                if (layout.has_value() && typedefDefinition->m_has_alignment_override)
+                    layout->m_alignment = typedefDefinition->m_alignment_override;
+                return layout;
+            }
+
+            default:
+                return Layout{definition->GetSize(), definition->GetAlignment()};
+            }
+        }
+
+        std::optional<Layout> Declaration(const TypeDeclaration& declaration, const WordSize ownerWordSize)
+        {
+            const auto pointerSize = GetPointerSizeForWordSize(ownerWordSize);
+            const auto containsPointer = std::ranges::any_of(declaration.m_declaration_modifiers,
+                                                             [](const auto& modifier)
+                                                             {
+                                                                 return modifier->GetType() == DeclarationModifierType::POINTER;
+                                                             });
+
+            std::optional<Layout> typeLayout;
+            if (!containsPointer || declaration.m_declaration_modifiers.empty()
+                || declaration.m_declaration_modifiers.back()->GetType() != DeclarationModifierType::POINTER)
+            {
+                typeLayout = Type(declaration.m_type, ownerWordSize);
+                if (!typeLayout.has_value())
+                    return std::nullopt;
+            }
+
+            unsigned size = 0u;
+            if (declaration.m_declaration_modifiers.empty())
+            {
+                size = typeLayout->m_size;
+            }
+            else
+            {
+                if (declaration.m_declaration_modifiers.back()->GetType() != DeclarationModifierType::POINTER)
+                    size = typeLayout->m_size;
+
+                for (auto i = declaration.m_declaration_modifiers.size(); i > 0u; --i)
+                {
+                    const auto& modifier = declaration.m_declaration_modifiers[i - 1u];
+                    if (modifier->GetType() == DeclarationModifierType::POINTER)
+                        size = pointerSize;
+                    else
+                        size *= static_cast<unsigned>(dynamic_cast<const ArrayDeclarationModifier*>(modifier.get())->m_size);
+                }
+            }
+
+            const auto alignment = declaration.GetForceAlignment() ? declaration.GetAlignment() : (containsPointer ? pointerSize : typeLayout->m_alignment);
+            return Layout{size, alignment};
+        }
+
+        IDataRepository* m_repository;
+        WordSize m_default_word_size;
+        std::map<std::pair<const DefinitionWithMembers*, WordSize>, Layout> m_layouts;
+        std::set<std::pair<const DefinitionWithMembers*, WordSize>> m_calculating;
+    };
+} // namespace
+
+bool SerializedLayoutPostProcessor::PostProcess(IDataRepository* repository)
+{
+    return LayoutCalculator(repository).Calculate();
+}
