+
+std::optional<std::size_t> ZoneMemory::GetRemainingSize(const void* data) const
+{
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    for (const auto& block : m_blocks)
+    {
+        const auto begin = reinterpret_cast<std::uintptr_t>(block->m_buffer.get());
+        if (address >= begin && address - begin < block->m_buffer_size)
+            return block->m_buffer_size - (address - begin);
+    }
+
+    return MemoryManager::GetRemainingSize(data);
+}
