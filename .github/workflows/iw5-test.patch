 #include <iomanip>
 #include <iostream>
 #include <map>
+#include <sstream>
+
+namespace
+{
+    void AppendWrappedDescription(std::stringstream& output, const std::string& prefix, const std::string& description, const size_t lineWidth)
+    {
+        output << prefix;
+
+        if (description.empty())
+        {
+            output << "\n";
+            return;
+        }
+
+        std::istringstream words(description);
+        const std::string continuationIndent(prefix.size(), ' ');
+        size_t currentLineLength = prefix.size();
+        bool firstWord = true;
+        std::string word;
+
+        while (words >> word)
+        {
+            const size_t separatorLength = firstWord ? 0u : 1u;
+            if (!firstWord && currentLineLength + separatorLength + word.size() > lineWidth)
+            {
+                output << "\n" << continuationIndent;
+                currentLineLength = continuationIndent.size();
+                firstWord = true;
+            }
+
+            if (!firstWord)
+            {
+                output << " ";
+                currentLineLength++;
+            }
+
+            output << word;
+            currentLineLength += word.size();
+            firstWord = false;
+        }
+
+        output << "\n";
+    }
+}
 
