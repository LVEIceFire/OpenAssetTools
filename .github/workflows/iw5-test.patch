+#include "Zone/ZoneScriptStrings.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <stdexcept>
+
+namespace
+{
+    TEST_CASE("Zone script strings reject the first index past the end", "[zone][script-strings]")
+    {
+        ZoneScriptStrings strings;
+        bool isNull = false;
+
+        REQUIRE(strings.Count() == 1u);
+        REQUIRE_THROWS_AS(strings.CValue(strings.Count()), std::runtime_error);
+        REQUIRE_THROWS_AS(strings.Value(strings.Count()), std::runtime_error);
+        REQUIRE_THROWS_AS(strings.Value(strings.Count(), isNull), std::runtime_error);
+        REQUIRE_THROWS_AS(strings[strings.Count()], std::runtime_error);
+    }
+
+    TEST_CASE("Empty existing-zone script strings reject index zero", "[zone][script-strings]")
+    {
+        ZoneScriptStrings strings;
+        strings.InitializeForExistingZone();
+
+        REQUIRE(strings.Empty());
+        REQUIRE_THROWS_AS(strings.CValue(0u), std::runtime_error);
+        REQUIRE_THROWS_AS(strings.Value(0u), std::runtime_error);
+        REQUIRE_THROWS_AS(strings[0u], std::runtime_error);
+    }
+} // namespace
